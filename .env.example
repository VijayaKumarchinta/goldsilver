# Copy to .env. Never commit .env or paste its values anywhere.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
SECRET_KEY=replace-with-python-secrets-token-hex-32
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
XAUS_BASE=https://xaus.com
# MCX futures are the price source. MCX may block cloud/datacentre IPs; test with: python -m app.providers.metals_mcx
MCX_ENABLED=1
MCX_ROLL_DAYS=5
# Dashboard-only estimate when MCX is unreachable (India's import duty is 15% since 13 May 2026)
ESTIMATE_PREMIUM_GOLD=0.15
ESTIMATE_PREMIUM_SILVER=0.15
