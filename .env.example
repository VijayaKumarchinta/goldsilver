# Runtime .env.example

# Required - Render auto-provides this from its PostgreSQL addon
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/goldbot

# Required - generate a random string for production
SECRET_KEY=replace-with-a-long-random-string

# Telegram notifications (optional - disable if you don't use Telegram)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=-1001234567890

# API endpoints (optional)
XAUS_BASE=https://xaus.com
FREEAPI_BASE=https://api.oropocket.com/public

# Staleness and validation thresholds (optional)
MAX_PRICE_STALENESS_SECONDS=300
MAX_SINGLE_TICK_JUMP_PCT=15.0
MAX_JUMP_REFERENCE_AGE_SECONDS=3600
MIN_USD_INR=50
MAX_USD_INR=150
